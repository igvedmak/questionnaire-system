# Copy to .env and fill in the values you need.
# All settings are optional — the engine runs with no config at all.

# ── PII encryption ────────────────────────────────────────────────────────────
# Leave empty to auto-generate on first boot (key saved to data/.qst_pii.key).
# In production, set this from your secret manager.
QST_PII_KEY=

# ── AI features (optional) ────────────────────────────────────────────────────
# Without these, the engine runs fully; AI endpoints return 503.
#
# QST_LLM_MODEL uses litellm model strings — the provider is encoded in the name:
#
#   Anthropic Claude (default):
#     QST_LLM_API_KEY=sk-ant-...
#     QST_LLM_MODEL=anthropic/claude-opus-4-7
#
#   OpenAI:
#     QST_LLM_API_KEY=sk-...
#     QST_LLM_MODEL=gpt-4o
#
#   Google Gemini:
#     QST_LLM_API_KEY=AIza...
#     QST_LLM_MODEL=gemini/gemini-1.5-pro
#
#   Local Ollama (no key needed):
#     QST_LLM_MODEL=ollama/llama3
#     QST_LLM_BASE_URL=http://host.docker.internal:11434
#
QST_LLM_API_KEY=
QST_LLM_MODEL=anthropic/claude-opus-4-7
QST_LLM_BASE_URL=

# ── HuggingFace (optional) ────────────────────────────────────────────────────
# Without this token, model downloads still work but may be rate-limited.
HF_TOKEN=

# ── API auth (optional) ───────────────────────────────────────────────────────
# Comma-separated list of API keys. When set, write endpoints require
# X-API-Key: <key>. Leave empty for open access.
QST_API_KEYS=
