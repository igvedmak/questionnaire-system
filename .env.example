# Copy to .env and fill in values.
# QST_PII_KEY: Fernet key for PII encryption. Leave empty to auto-generate
#              (key is saved to data/.qst_pii.key on first boot).
#              Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
QST_PII_KEY=

# HF_TOKEN: HuggingFace token (optional). Without it, model downloads still
#            work but are rate-limited and print a warning.
HF_TOKEN=
